# ============================================================================
#  J-lens / J-space configuration.  Edit this file — nothing else.
#  Real shell environment variables override anything set here.
# ============================================================================

# ---- model -----------------------------------------------------------------
# Any dense Qwen3: Qwen3-0.6B / 1.7B / 4B / 8B / 14B / 32B.
# The lens filename and the workspace band follow the model automatically, so
# switching back and forth never recomputes or overwrites anything.
MODEL_NAME=Qwen/Qwen3-4B

# ---- how much corpus to average the Jacobian over --------------------------
# The paper uses 1000.  Fig. 59: even 10-100 sequences beats the logit and
# tuned lenses.  Cost is linear, and roughly (params x d_model) across models —
# measured on a GB10: 21 s/prompt at 0.6B, ~5.8 min/prompt at 4B.
N_PROMPTS=1000
SEQ_LEN=128

# Shuffle seed for the corpus sample. The corpus is a 50/50 mix of C4 web text
# and WikiText-103, ~25% short passages / 75% long, shuffled and cached on disk.
CORPUS_SEED=0

# Pick up a compatible checkpoint instead of starting over. Makes a long
# unattended run survive a crash, an OOM, or a killed session.
RESUME=true

# Checkpoint interval, in prompts.  Every checkpoint is a complete, usable
# lens, so you can Ctrl-C whenever you have enough.  Keep this small enough
# that you never lose more than ~30 min of work.
SAVE_EVERY=4

# ---- speed / memory --------------------------------------------------------
# Jacobian rows produced per backward pass (= forward batch size).  Main memory
# dial for step 00.  4-8 on a 24 GB card, 16 is fine on 80 GB+.
ROWS_PER_BACKWARD=16

# float32 is the default and the accurate choice: step 00 propagates gradients
# through every block.  bfloat16 roughly halves memory at a real cost in
# precision.
LENS_DTYPE=float32

# TF32 is ~2.3x faster than float32 on recent NVIDIA cards (measured on a GB10:
# 18 -> 41 TFLOPS) and keeps 10 mantissa bits vs float32's 23 — still well
# above bfloat16's 8.  Set true when a run would otherwise take days.
ALLOW_TF32=false

# ---- everything below is a paper-faithful default: change only deliberately -

# Backward-pass target: "penultimate" (the paper's default recipe, omitting the
# last transformer block) or "final" (the §A.7 variant).
TARGET=penultimate

# Source positions dropped from the within-prompt average.  0 = the paper's
# default; §A.7 tried excluding early positions and found no improvement.
SKIP_FIRST=0

# Workspace layer band (§4.1).  "auto" derives it from the model's depth using
# WORKSPACE_BAND — for Qwen3-4B's 36 blocks that is layers 14-33, for 0.6B's 28
# it is 11-26.  Run experiments/09_workspace_layers.py, then pin the calibrated
# band here as e.g. WORKSPACE_LAYERS=14-33
WORKSPACE_LAYERS=auto
WORKSPACE_BAND=0.38,0.92

# ---- rarely needed ---------------------------------------------------------
# DEVICE=cuda
# DTYPE=bfloat16                  # dtype for experiments 01-12 (not step 00)
# JLENS_PATH=/some/other/path.pt  # default: <repo>/jlens_<model>.pt
